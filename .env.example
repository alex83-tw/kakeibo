NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 只在本機開發用；正式環境一律忽略
KAKEIBO_DEV_USER_ID=
# 登入連結要回到的網址（伺服器端設定，不從請求標頭推導）。正式環境必填，例如 https://kakeibo.example.com
# 同一個網址也要加進 Supabase → Authentication → URL Configuration → Redirect URLs（完整網址，不要用萬用字元）
NEXT_PUBLIC_SITE_URL=
# 只在本機：1 = 用記憶體內的假資料（不連資料庫），方便在瀏覽器試畫面。需同時設 KAKEIBO_DEV_USER_ID 才能略過登入頁。
KAKEIBO_DEV_FIXTURES=
