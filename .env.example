NEXT_PUBLIC_SUPABASE_URL=
# 只在伺服器端使用（不要加 NEXT_PUBLIC_）。與 financial-advisor 相同：不登入，用 service role 連線並繞過 RLS，
# 每個查詢都由程式以 user_id 限定。金鑰外流 = 整個資料庫外流，不可提交、不可給瀏覽器。
SUPABASE_SERVICE_ROLE_KEY=
# 單一使用者的 id。留空 = 與 financial-advisor 相同的 00000000-0000-0000-0000-000000000000
KAKEIBO_USER_ID=
# 只在本機：1 = 用記憶體內的假資料（不連資料庫），方便在瀏覽器試畫面。
KAKEIBO_DEV_FIXTURES=
